{
  "twoWCommandTestCases": [
    {
      "id": "CMD_01_Camino_Exitoso_Iniciacion_Valida",
      "commandLine": "2w --guia=10 --est=5 --radio=2.5",
      "expectedSuccess": true,
      "expectedMessageContains": "Disposicion iniciada."
    },
    {
      "id": "CMD_02_Error_Estacion_Fuera_De_Rango_Maximo",
      "commandLine": "2w --guia=10 --est=69",
      "expectedSuccess": false,
      "expectedMessageContains": "--est debe estar entre 1 y 68."
    },
    {
      "id": "CMD_03_Error_Radio_Invalido_Negativo",
      "commandLine": "2w --guia=10 --est=5 --radio=-1.5",
      "expectedSuccess": false,
      "expectedMessageContains": "--radio debe ser un numero positivo."
    },
    {
      "id": "CMD_04_Error_Estacion_Fuera_De_Rango_Minimo",
      "commandLine": "2w --guia=10 --est=0",
      "expectedSuccess": false,
      "expectedMessageContains": "--est debe estar entre 1 y 68."
    },
    {
      "id": "CMD_05_Error_Faltan_Parametros_Requeridos",
      "commandLine": "2w --guia=10",
      "expectedSuccess": false,
      "expectedMessageContains": "Faltan --guia y --est"
    },
    {
      "id": "CMD_06_Error_Detener_Sin_Sesion_Activa",
      "commandLine": "2w --stop",
      "expectedSuccess": false,
      "expectedMessageContains": "no se encuentra activa"
    },
    {
      "id": "CMD_07_Error_Estacion_No_Presente",
      "commandLine": "2w --guia=10 --est=26",
      "expectedSuccess": false,
      "expectedMessageContains": "La estacion 26 no esta presente en la tabla."
    },
    {
      "id": "CMD_08_Camino_Exitoso_Con_Aliadas",
      "commandLine": "2w --guia=10 --est=5 --aliadas=1,2,3",
      "expectedSuccess": true,
      "expectedMessageContains": "Disposicion iniciada."
    },
    {
      "id": "CMD_09_Error_Aliada_Fuera_De_Rango",
      "commandLine": "2w --guia=10 --est=5 --aliadas=1,69,3",
      "expectedSuccess": false,
      "expectedMessageContains": "fuera de rango"
    },
    {
      "id": "CMD_10_Error_Aliada_No_Presente_En_Tabla",
      "commandLine": "2w --guia=10 --est=5 --aliadas=1,26,3",
      "expectedSuccess": false,
      "expectedMessageContains": "no esta presente en la tabla"
    }
  ]
}