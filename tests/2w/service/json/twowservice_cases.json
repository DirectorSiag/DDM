{
  "twoWServiceTestCases": [
    {
      "id": "SVC_01_StartSession_ActivaLaSesion",
      "description": "startSession debe setear active=true y los parámetros en twoWSession",
      "guideTrackId": 1,
      "bpStation": 12,
      "circleRadiusNm": 1.0,
      "expected": {
        "active": true,
        "guideTrackId": 1,
        "bpStation": 12,
        "circleRadiusNm": 1.0
      }
    },
    {
      "id": "SVC_02_StopSession_DesactivaLaSesion",
      "description": "stopSession debe resetear twoWSession a su estado inicial",
      "guideTrackId": 1,
      "bpStation": 12,
      "circleRadiusNm": 1.0,
      "expected": {
        "active": false,
        "guideTrackId": -1,
        "bpStation": -1,
        "matchesDefaultState": true
      }
    },
    {
      "id": "SVC_03_Update_SinSesionActiva_NoCalcula",
      "description": "update() sin sesión activa no debe modificar twoWSession",
      "guideTrackId": -1,
      "bpStation": -1,
      "circleRadiusNm": 1.0,
      "expected": {
        "etaValid": false,
        "stateUnchanged": true
      }
    },
    {
      "id": "SVC_04_Update_SinGuia_DetieneSesion",
      "description": "update() con guía inexistente debe llamar stopSession y desactivar",
      "guideTrackId": 9999,
      "bpStation": 12,
      "circleRadiusNm": 1.0,
      "expected": {
        "active": false,
        "matchesDefaultState": true
      }
    },
    {
      "id": "SVC_05_Update_ConGuia_PopulaResultados",
      "description": "update() con guía válido debe poblar los campos de resultado en twoWSession",
      "guideTrackX": 100.0,
      "guideTrackY": 100.0,
      "guideTrackId": 1,
      "bpStation": 12,
      "circleRadiusNm": 1.0,
      "ownSpeed": 10.0,
      "selectedStations": [1, 2, 3],
      "expected": {
        "active": true,
        "trackValid": true,
        "guideCircleCenter": { "x": 100.0, "y": 100.0 },
        "ownCircleCenter": { "x": 95.94926, "y": 100.0 },
        "allyCircleCenters": [
          { "x": 101.012685, "y": 101.754022 },
          { "x": 98.987315, "y": 101.754022 },
          { "x": 102.025370, "y": 100.000000 }
        ],
        "etaValid": true,
        "courseToStationDeg": 43.815728,
        "timeToStationMin": 831.519920,
        "currentAzimuthDeg": 225.0,
        "currentDistanceNm": 139.649897,
        "expectedAzimuthDeg": 270.0,
        "expectedDistanceNm": 4.0,
        "tolerance": 0.001,
        "angleTolerance": 0.1,
        "distanceTolerance": 0.1
      }
    },
    {
      "id": "SVC_06_Update_VelocidadCero_EtaInvalida",
      "description": "update() con ownSpeed=0 debe resultar en etaValid=false",
      "guideTrackX": 100.0,
      "guideTrackY": 100.0,
      "guideTrackId": 1,
      "bpStation": 12,
      "circleRadiusNm": 1.0,
      "ownSpeed": 0.0,
      "expected": {
        "etaValid": false
      }
    },
    {
      "id": "SVC_07_StartSession_SobreescribeSesionAnterior",
      "description": "Llamar startSession dos veces debe sobreescribir los parámetros anteriores",
      "guideTrackId": 2,
      "bpStation": 5,
      "circleRadiusNm": 2.0,
      "expected": {
        "active": true,
        "guideTrackId": 2,
        "bpStation": 5,
        "circleRadiusNm": 2.0
      }
    }
  ]
}
